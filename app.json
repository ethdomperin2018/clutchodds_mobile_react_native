{
  "expo": {
    "name": "Clutch Odds Mobile",
    "slug": "clutch-odds-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clutchodds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
