{
  "expo": {
    "name": "Clutch Odds Mobile",
    "slug": "clutch-odds-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clutchodds",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-tight.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clutchodds.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Clutch Odds uses the camera only if you choose to scan a payment card."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.clutchoddsmobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo-tight.jpg",
          "imageWidth": 220
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
