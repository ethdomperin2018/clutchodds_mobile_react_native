{
  "expo": {
    "name": "Clutch Odds Mobile",
    "slug": "clutch-odds-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clutchodds",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-tight.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo-tight.jpg",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
