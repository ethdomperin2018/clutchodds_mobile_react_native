# Set false to hit the real Next.js API (email verify, auth, etc.)
EXPO_PUBLIC_UI_ONLY=false

# Optional override. Prefer leaving this unset so the app auto-picks:
# - Expo web: http://localhost:3000
# - Android emulator: http://10.0.2.2:3000
# - Physical phone (Expo Go): http://<your-PC-LAN-IP>:3000 (from Metro host)
#
# If you set localhost here, native builds rewrite it automatically.
# For a manual device override, use your PC LAN IP, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Origin used to open Google OAuth in the system browser.
# Must match Next APP_BASE_URL / Google redirect URI host.
# Defaults to EXPO_PUBLIC_API_BASE_URL when unset.
# For Expo Go on a physical device, set both API + OAuth to your PC LAN IP,
# and set APP_BASE_URL on the Next server to that same LAN URL.
# EXPO_PUBLIC_OAUTH_BASE_URL=http://192.168.1.10:3000

# Optional. The server STRIPE_PUBLISHABLE_KEY is preferred (pk_test_ / pk_live_).
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public web origin for Terms (/terms) and Privacy (/privacy).
# Defaults to https://www.clutchodds.com. Override for local Next preview:
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
